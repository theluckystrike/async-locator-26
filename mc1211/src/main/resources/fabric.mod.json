	"authors": ["theluckystrike"],
	"contributors": ["bright_spark (original Async Locator idea, MIT)"],
	"contact": {
		"homepage": "https://modrinth.com/mod/async-locator-26",
		"sources": "https://github.com/theluckystrike/async-locator-26",
		"issues": "https://github.com/theluckystrike/async-locator-26/issues"
	},
	"license": "MIT",
	"icon": "assets/async-locator-26/icon.png",
	"environment": "*",
	"entrypoints": { "main": ["com.zovo.asynclocator.AsyncLocatorMod"] },
	"mixins": ["async-locator-26.mixins.json"],
	"depends": {
		"fabricloader": ">=0.17.0",
		"minecraft": "1.21.11",
		"java": ">=21"
	},
	"breaks": { "asynclocator": "*" }
